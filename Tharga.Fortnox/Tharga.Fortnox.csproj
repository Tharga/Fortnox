<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Company>Thargelion AB</Company>
		<Product>Tharga Fortnox</Product>
		<Description>Handling of Fortnox authentication keys.</Description>
		<PackageIconUrl>https://thargelion.net/assets/component-fortnox.png</PackageIconUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageProjectUrl>https://github.com/Tharga/Fortnox</PackageProjectUrl>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
	</PropertyGroup>

	<PropertyGroup>
		<!--
			NU5048: PackageIconUrl is deprecated in favour of an embedded PackageIcon.
			Suppressed deliberately. Tharga packages reference their icon from
			https://thargelion.net/assets/ so all package icons are maintained in one
			place and can be updated without republishing a package.
		-->
		<NoWarn>1701;1702;CS1591;NU5048</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Tharga.Fortnox.Tests" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.10" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
	</ItemGroup>

</Project>